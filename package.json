{
  "name": "pi-extensions",
  "private": true,
  "keywords": ["pi-package"],
  "pi": {
    "extensions": [
      "packages/auto-retry",
      "packages/caffeinate",
      "packages/pi-adhd",
      "packages/pi-ask",
      "packages/pi-baml",
      "packages/pi-games",
      "packages/pi-memory",
      "packages/pi-modes",
      "packages/pi-readonly-bash",
      "packages/pi-repos",
      "packages/pi-status",
      "packages/pi-task",
      "packages/pi-term",
      "packages/pi-todo"
    ],
    "skills": [
      "packages/pi-baml/skills"
    ]
  },
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
