{
  "name": "@pedroklein/pi-term",
  "version": "0.1.0",
  "description": "Floating terminal for TUI apps in Pi",
  "type": "module",
  "main": "./index.ts",
  "files": ["*.ts"],
  "scripts": {
    "build": "tsup index.ts --format esm --dts",
    "clean": "rm -rf dist"
  },
  "pi": {
    "extensions": ["./index.ts"]
  },
  "keywords": ["pi-package", "pi", "terminal", "tui", "floating", "coding-agent"],
  "license": "MIT",
  "author": "Pedro Klein",
  "engines": { "node": ">=20.0.0" },
  "dependencies": {
    "node-pty": "^1.0.0",
    "@xterm/headless": "^5.5.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
