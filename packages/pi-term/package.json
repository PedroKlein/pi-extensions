{
  "name": "@pedroklein/pi-term",
  "version": "0.1.0",
  "description": "Floating terminal panel for Pi TUI",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["src"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "keywords": ["pi-package", "pi", "terminal", "tui", "floating", "pty", "coding-agent"],
  "license": "MIT",
  "author": "Pedro Klein",
  "repository": {
    "type": "git",
    "url": "https://github.com/PedroKlein/pi-extensions",
    "directory": "packages/pi-term"
  },
  "homepage": "https://github.com/PedroKlein/pi-extensions/tree/main/packages/pi-term",
  "engines": { "node": ">=20.0.0" },
  "dependencies": {
    "node-pty": "^1.0.0",
    "@xterm/headless": "^5.5.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
