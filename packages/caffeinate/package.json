{
  "name": "@pedroklein/pi-caffeinate",
  "version": "0.1.0",
  "description": "Prevent macOS sleep during Pi agent work",
  "type": "module",
  "main": "./index.ts",
  "files": ["dist", "index.ts"],
  "scripts": {
    "build": "tsup index.ts --format esm --dts",
    "clean": "rm -rf dist"
  },
  "pi": {
    "extensions": ["./index.ts"]
  },
  "keywords": ["pi-package", "pi", "caffeinate", "macos", "coding-agent"],
  "license": "MIT",
  "author": "Pedro Klein",
  "engines": { "node": ">=20.0.0" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
