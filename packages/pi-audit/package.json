{
  "name": "@pedro_klein/pi-audit",
  "version": "0.1.0",
  "description": "Prompt, cache, context, and nested-usage observability for Pi",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "audit",
    "tokens",
    "cache",
    "observability"
  ],
  "license": "MIT",
  "author": "Pedro Klein",
  "repository": {
    "type": "git",
    "url": "https://github.com/PedroKlein/pi-extensions",
    "directory": "packages/pi-audit"
  },
  "homepage": "https://github.com/PedroKlein/pi-extensions/tree/main/packages/pi-audit",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "gpt-tokenizer": "^3.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
