{
  "name": "@pedro_klein/pi-repos",
  "version": "0.2.0",
  "description": "Repo management + orchestration layer for Pi — clone, index, search, annotate, group, references",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "src",
    "skills"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "repos",
    "repository",
    "management",
    "search",
    "annotate",
    "coding-agent"
  ],
  "license": "MIT",
  "author": "Pedro Klein",
  "repository": {
    "type": "git",
    "url": "https://github.com/PedroKlein/pi-extensions",
    "directory": "packages/pi-repos"
  },
  "homepage": "https://github.com/PedroKlein/pi-extensions/tree/main/packages/pi-repos",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
