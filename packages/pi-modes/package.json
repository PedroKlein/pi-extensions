{
  "name": "@pedro_klein/pi-modes",
  "version": "0.2.0",
  "description": "5-mode system for Pi — Ask, Brainstorm, Plan, Build, None with tool gating",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "src",
    "prompts"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "modes",
    "workflow",
    "tool-gating",
    "coding-agent"
  ],
  "license": "MIT",
  "author": "Pedro Klein",
  "repository": {
    "type": "git",
    "url": "https://github.com/PedroKlein/pi-extensions",
    "directory": "packages/pi-modes"
  },
  "homepage": "https://github.com/PedroKlein/pi-extensions/tree/main/packages/pi-modes",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
